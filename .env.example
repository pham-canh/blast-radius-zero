# Copy to .env (gitignored). Each person fills in their own key and exactly one
# model. No model id is bundled with this repo.
#   cp .env.example .env
#
# Default provider: Vultr Serverless Inference — required by the event for the demo.
INFERENCE_PROVIDER=vultr
INFERENCE_BASE_URL=https://api.vultrinference.com/v1

# REQUIRED: no model id is bundled. Pick one from the provider's own list:
#   python3 src/vultr_inference.py --list-models
# then paste the id here.
INFERENCE_MODEL=
INFERENCE_API_KEY=

# Optional: Claude / Anthropic key. Uncomment these (and remove the Vultr key)
# to run locally on a Claude model. Do NOT use this for the submitted demo:
# the challenge requires every LLM call to go through Vultr.
# ANTHROPIC_API_KEY=
# INFERENCE_PROVIDER=anthropic

# Optional: any OpenAI-compatible endpoint.
# INFERENCE_PROVIDER=openai
# INFERENCE_BASE_URL=https://api.openai.com/v1
# INFERENCE_API_KEY=

# Optional comma-separated fallbacks. Leave empty — no model ids are bundled.
INFERENCE_FALLBACK_MODELS=

# Only set this on the actual Vultr VM, so attestations record the real host.
# Auto-detected from DMI where available; do not fake it on a laptop.
# BLAST_RADIUS_BACKEND=vultr

# Optional: where the UI keeps run history and attestation files.
# BLAST_RADIUS_HISTORY=out/history.jsonl
# BLAST_RADIUS_OUTDIR=out
